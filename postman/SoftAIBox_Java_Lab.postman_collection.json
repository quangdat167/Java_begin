  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "01. Login USER - tự lưu token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login trả 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Có access và refresh token', function () {",
                  "    pm.expect(body.data.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.data.refreshToken).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.data.token);",
                  "pm.collectionVariables.set('refreshToken', body.data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/email/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "email", "login"]
            }
          }
        },
        {
          "name": "02. Get profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile trả 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Đúng USER đang đăng nhập', function () {",
                  "    pm.expect(pm.response.json().data.email).to.eql(pm.collectionVariables.get('userEmail'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        },
        {
          "name": "03. Refresh token - tự thay token cũ",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh trả 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Refresh token được rotate', function () {",
                  "    pm.expect(body.data.refreshToken).to.not.eql(pm.collectionVariables.get('refreshToken'));",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.data.token);",
                  "pm.collectionVariables.set('refreshToken', body.data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{refreshToken}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        }
      ]
